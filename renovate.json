{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Altinn/renovate-config",
    "local>Altinn/altinn-authorization-tmp:renovate"
  ],
  "packageRules": [
    {
      "description": "MSBuild 18.10 requires .NET 11; retain .NET 10-compatible versions",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "Microsoft.Build",
        "Microsoft.Build.Framework",
        "Microsoft.Build.Tasks.Core",
        "Microsoft.NET.StringTools"
      ],
      "allowedVersions": "<18.10"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update annotated NuGet tool versions in GitHub workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[a-z][A-Za-z0-9]*Version:\\s*[\\\"']?(?<currentValue>[^\\s\\\"']+)"
      ]
    }
  ]
}
